{
  "name": "m365-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Local web app that uses Microsoft 365 Copilot (its website, in its own minimized Edge window) as a chat and agent engine, with pluggable local tools.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "start": "node --disable-warning=ExperimentalWarning server.ts",
    "diag": "node diag.ts",
    "test": "node --test \"tests/**/*.test.mjs\" --test-concurrency=1",
    "test:unit": "node --test \"tests/unit/*.test.mjs\""
  },
  "dependencies": {
    "playwright-core": "^1.56.0"
  }
}
